<Window x:Class="TrueSleep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="True Sleep Tool - MySystem"
        Width="430"
        Height="355"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#01000000"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="White"
        SourceInitialized="OnSourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="22"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="22"
            BorderBrush="#48FFFFFF"
            BorderThickness="1"
            Background="#D9151C2D"
            MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition Height="68" />
                <RowDefinition Height="64" />
                <RowDefinition Height="53" />
                <RowDefinition Height="53" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE708;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="25"
                               Foreground="#FF8CC4FF"
                               Margin="0,0,11,0" />
                    <StackPanel>
                        <TextBlock Text="True Sleep"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="MySystem · Windows 11"
                                   FontSize="10"
                                   Foreground="#AFFFFFFF" />
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource WindowButton}"
                        Content="&#xE8BB;"
                        Click="OnCloseClick" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,7,0,9"
                    Padding="12,8"
                    CornerRadius="12"
                    Background="#22FFFFFF"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               Text="در حال بررسی وضعیت Sleep…"
                               FontSize="12.5"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetailText"
                               Margin="0,3,0,0"
                               Text=""
                               FontSize="10.5"
                               Foreground="#BFFFFFFF"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button x:Name="DeepSleepButton"
                    Grid.Row="2"
                    Margin="0,4,0,6"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnDeepSleepClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE823;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="19"
                               Margin="0,0,9,0" />
                    <TextBlock Text="خواب عمیق — خاموشی کامل فن و CPU"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="SleepButton"
                    Grid.Row="3"
                    Margin="0,3,0,5"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnSleepClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE708;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="16"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Force Sleep استاندارد ویندوز"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="LidButton"
                    Grid.Row="4"
                    Margin="0,3,0,5"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnConfigureLidClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7F8;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="16"
                               Margin="0,0,8,0" />
                    <TextBlock Text="با بستن درِ لپ‌تاپ، خواب عمیق فعال شود"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Row="5"
                       Margin="3,8,3,0"
                       Text="خواب عمیق همان Hibernate است؛ برنامه‌ها باز می‌مانند اما برق CPU و فن کاملاً قطع می‌شود."
                       FontSize="10.5"
                       Foreground="#AFFFFFFF"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
