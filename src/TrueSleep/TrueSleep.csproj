<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TrueSleep</AssemblyName>
    <RootNamespace>TrueSleep</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>MySystem</Authors>
    <Product>True Sleep Tool - MySystem</Product>
    <Description>Force real Windows sleep or guaranteed fan-off deep sleep on Windows 11 laptops.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\App.ico" LogicalName="TrueSleep.App.ico" />
  </ItemGroup>
</Project>
